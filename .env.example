# The settings of the start scripts. Copy this file to .env.local, which git
# ignores, and fill in what you need there. A variable that is already set in
# the environment wins over the file.
#
# This file holds no real value, and it must stay that way: the repository is
# public, and the name of the vault and the names of the certificates in it
# are not written into it.

# The vault the certificates come from: its address, https://... A local
# start needs it, and `az login` with an account that may read the
# certificates and their secrets.
# KEYVAULT_URL=

# The names of the certificates in the vault, separated by commas. The first
# is the default: it is presented for a host name that no certificate covers,
# and it is the one `npm run dev` serves with.
# KEYVAULT_CERTIFICATES=

# Where the key and certificate pairs are written, one folder per
# certificate. When no vault is named, the production start reads a pair from
# here instead: key.pem and cert.pem. Default: .certs
# CERT_DIR=

# The port of the HTTPS listener of the production start. Default: 3000
# PORT=

# How long an idle connection is kept open, in milliseconds. Default: what
# Node.js does by itself.
# KEEP_ALIVE_TIMEOUT=

# The port of the plain HTTP listener of the production start, which only
# redirects to HTTPS. Default: 3080
# HTTP_PORT=

# The HTTPS port a visitor uses, for the target of that redirect. It is left
# out of the address when it is 443. Default: 443
# PUBLIC_HTTPS_PORT=

# The one address both listeners bind. Default: every address of the machine,
# IPv4 and IPv6.
# BIND_HOST=

# The site's main address. Every page names its own address under it as its
# canonical address. Default: https://openbreach.dev
# PUBLIC_BASE_URL=

# The host name and the port of `npm run dev`. Default: local.openbreach.dev
# and 14443
# DEV_HOST=
# DEV_PORT=
